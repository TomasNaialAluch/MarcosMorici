# Copiá este archivo a `.env.local` y completá los valores (Firebase Console → Configuración del proyecto → Tu app web).

# --- Firebase (catálogo /comprar + formulario /vender) ---
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET: obligatorio para subir fotos/PDF del formulario Vender.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Sitio y WhatsApp ---
# Authentication: en Firebase Console → Authentication activá "Correo electrónico/contraseña" y/o "Google".
# Agregá localhost (y tu dominio en producción) en Authentication → Settings → Authorized domains.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=
