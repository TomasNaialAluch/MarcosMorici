rules_version = '2';

// Desplegar: `firebase deploy --only firestore:rules`
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /equipos/{id} {
      allow read: if (!resource.data.keys().hasAny(['publicado']) || resource.data.publicado != false)
        || (request.auth != null
          && resource.data.keys().hasAny(['ownerId'])
          && resource.data.ownerId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'ownerId',
          'marca',
          'modelo',
          'slug',
          'imagenes',
          'publicado',
          'destacado',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.marca is string
        && request.resource.data.modelo is string
        && request.resource.data.slug is string
        && request.resource.data.imagenes is list
        && request.resource.data.publicado is bool
        && request.resource.data.destacado == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.marca.size() >= 1
        && request.resource.data.marca.size() <= 200
        && request.resource.data.modelo.size() >= 1
        && request.resource.data.modelo.size() <= 200;

      allow update: if request.auth != null
        && resource.data.keys().hasAny(['ownerId'])
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.destacado == resource.data.destacado
        && request.resource.data.marca is string
        && request.resource.data.modelo is string
        && request.resource.data.slug is string
        && request.resource.data.imagenes is list
        && request.resource.data.publicado is bool
        && request.resource.data.updatedAt is timestamp;

      allow delete: if request.auth != null
        && resource.data.keys().hasAny(['ownerId'])
        && resource.data.ownerId == request.auth.uid;
    }

    match /equipoContactos/{id} {
      allow create: if request.resource.data.keys().hasAll(['tipo', 'equipoId', 'slug', 'createdAt'])
        && request.resource.data.tipo is string
        && request.resource.data.equipoId is string
        && request.resource.data.slug is string;
      allow read, update, delete: if false;
    }

    match /venderLeads/{id} {
      allow create: if isAdmin()
        && request.resource.data.source == 'web-vender'
        && request.resource.data.keys().hasAll([
          'source',
          'clientFolder',
          'createdAt',
          'tipoMaquinaria',
          'tipoOtrosDescripcion',
          'condicion',
          'horas',
          'marca',
          'modelo',
          'titulo',
          'categoriaCatalogo',
          'sku',
          'ano',
          'precio',
          'precioConsultar',
          'moneda',
          'pesoTotalKg',
          'capacidadBaldeM3',
          'descripcionMaquina',
          'nombreApellido',
          'email',
          'celular',
          'ubicacion',
          'mensajeAdicional',
          'folletoUrl',
          'folletoUrlIngresada',
          'imagenesUrls',
          'adjuntosUrls'
        ])
        && request.resource.data.marca is string
        && request.resource.data.modelo is string
        && (request.resource.data.precio == null || request.resource.data.precio is string)
        && request.resource.data.nombreApellido is string
        && request.resource.data.email is string
        && request.resource.data.celular is string
        && request.resource.data.ubicacion is string
        && request.resource.data.clientFolder is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.precioConsultar is bool
        && (request.resource.data.tipoMaquinaria == null
          || request.resource.data.tipoMaquinaria in [
            'retroexcavadoras',
            'compactacion',
            'motoniveladoras',
            'cargadoras',
            'minicargadoras',
            'topadoras',
            'miniexcavadoras',
            'otros'
          ])
        && request.resource.data.condicion in ['nuevo', 'usado']
        && request.resource.data.moneda in ['pesos', 'dolar']
        && request.resource.data.marca.size() <= 200
        && request.resource.data.modelo.size() <= 200
        && request.resource.data.email.size() <= 320
        && request.resource.data.celular.size() <= 40
        && request.resource.data.ubicacion.size() <= 300
        && request.resource.data.imagenesUrls is list
        && request.resource.data.imagenesUrls.size() <= 40
        && (request.resource.data.horas == null || request.resource.data.horas is number)
        && (request.resource.data.ano == null || request.resource.data.ano is number)
        && (request.resource.data.pesoTotalKg == null || request.resource.data.pesoTotalKg is number)
        && (request.resource.data.capacidadBaldeM3 == null || request.resource.data.capacidadBaldeM3 is number)
        && (request.resource.data.titulo == null || request.resource.data.titulo is string)
        && (request.resource.data.categoriaCatalogo == null || request.resource.data.categoriaCatalogo is string)
        && (request.resource.data.sku == null || request.resource.data.sku is string)
        && (request.resource.data.tipoOtrosDescripcion == null || request.resource.data.tipoOtrosDescripcion is string)
        && (request.resource.data.descripcionMaquina == null || request.resource.data.descripcionMaquina is string)
        && (request.resource.data.mensajeAdicional == null || request.resource.data.mensajeAdicional is string)
        && (request.resource.data.folletoUrl == null || request.resource.data.folletoUrl is string)
        && (request.resource.data.folletoUrlIngresada == null || request.resource.data.folletoUrlIngresada is string)
        && (request.resource.data.adjuntosUrls == null || request.resource.data.adjuntosUrls is list);
      allow read, update, delete: if false;
    }

    match /venderSolicitudes/{id} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.source == 'web-vender-simple'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'source',
          'ownerId',
          'clientFolder',
          'createdAt',
          'marca',
          'modelo',
          'descripcion',
          'precio',
          'precioConsultar',
          'moneda',
          'nombreApellido',
          'email',
          'celular',
          'ubicacion',
          'folletoUrl',
          'imagenesUrls',
          'status'
        ])
        && request.resource.data.marca is string
        && request.resource.data.modelo is string
        && request.resource.data.clientFolder is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.precioConsultar is bool
        && request.resource.data.moneda in ['pesos', 'dolar']
        && request.resource.data.nombreApellido is string
        && request.resource.data.email is string
        && request.resource.data.celular is string
        && request.resource.data.imagenesUrls is list
        && request.resource.data.marca.size() >= 1
        && request.resource.data.marca.size() <= 200
        && request.resource.data.modelo.size() >= 1
        && request.resource.data.modelo.size() <= 200
        && request.resource.data.nombreApellido.size() >= 1
        && request.resource.data.nombreApellido.size() <= 200
        && request.resource.data.email.size() <= 320
        && request.resource.data.celular.size() <= 40
        && (request.resource.data.descripcion == null || request.resource.data.descripcion is string)
        && (request.resource.data.precio == null || request.resource.data.precio is string)
        && (request.resource.data.ubicacion == null || request.resource.data.ubicacion is string)
        && (request.resource.data.folletoUrl == null || request.resource.data.folletoUrl is string)
        && request.resource.data.imagenesUrls.size() <= 40;
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.role == 'user'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.email is string || request.resource.data.email == null)
        && (request.resource.data.displayName is string || request.resource.data.displayName == null)
        && (request.resource.data.photoURL is string || request.resource.data.photoURL == null);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /conversaciones/{cid} {
      allow read: if request.auth != null
        && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'customerUid',
          'title',
          'lastMessage',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 200
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null
        && (resource.data.customerUid == request.auth.uid || isAdmin())
        && request.resource.data.customerUid == resource.data.customerUid;
      allow delete: if false;

      match /mensajes/{mid} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/conversaciones/$(cid)).data.customerUid == request.auth.uid
          || isAdmin()
        );
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['senderUid', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt is timestamp
          && (
            get(/databases/$(database)/documents/conversaciones/$(cid)).data.customerUid == request.auth.uid
            || isAdmin()
          );
        allow update, delete: if false;
      }
    }
  }
}
